<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.cmps.tetrahedron.view.common.Switch"
      stylesheets="@/style/switch.css">

    <Label fx:id="label" styleClass="data-label" text="label"/>
    <Pane HBox.hgrow="ALWAYS"/>
    <Button fx:id="button" onMouseClicked="#onClick" styleClass="switch">
        <graphic>
            <fx:include source="/icon/Circle.fxml"/>
        </graphic>
    </Button>
</HBox>
