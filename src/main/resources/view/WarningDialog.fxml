<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            stylesheets="@/style/error-dialog.css"
            minWidth="400" minHeight="250">
    <content>
        <StackPane>
            <VBox alignment="CENTER" spacing="30" maxWidth="291" maxHeight="268">
                <Label fx:id="errorTitle" styleClass="error-title" text="Увага!" />
                <Label fx:id="errorMessage" styleClass="error-message" wrapText="true"
                       text="Таблиця координат містить точки, що не використовуються в матриці індексів. Ви впевнені, що хочете продовжити?" />
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="yesButton" text="Так" styleClass="error-button" />
                    <Button fx:id="noButton" text="Ні" styleClass="error-button" />
                </HBox>
            </VBox>
        </StackPane>
    </content>
</DialogPane>
