<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.cmps.tetrahedron.view.component.LegendItem"
      stylesheets="@/style/legend-item.css"
      styleClass="item"
      alignment="CENTER">
    <HBox fx:id="color" styleClass="color, color-border"/>
    <TextField fx:id="start" styleClass="label, start-label" editable="false"/>
    <TextField fx:id="end" styleClass="label, end-label" visible="false" editable="false"/>
</VBox>
