<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.cmps.tetrahedron.view.DeformationScaleDialog"
            stylesheets="@/style/deformation-scale-dialog.css"
            minWidth="400" minHeight="250">

    <content>
        <StackPane>
            <VBox alignment="CENTER" spacing="20" maxWidth="320" maxHeight="240">
                <Label text="Переміщення у вузлах" styleClass="dialog-title"/>
                <HBox spacing="10" alignment="CENTER">
                    <VBox alignment="CENTER_LEFT">
                        <Label text="Масштаб відображення" styleClass="dialog-label-bold"/>
                        <Label text="деформацій моделі" styleClass="dialog-label-bold"/>
                    </VBox>
                    <TextField fx:id="scaleInput" styleClass="input-field"/>
                </HBox>
                <Button fx:id="saveButton" text="Зберегти" styleClass="save-button" onAction="#applyChanges"/>
            </VBox>
        </StackPane>
    </content>
</DialogPane>
