<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.cmps.tetrahedron.view.RightToolbar"
      stylesheets="@/style/right-toolbar.css"
      prefWidth="195" prefHeight="413"
      styleClass="root-box">

    <VBox styleClass="vbox-label-button">
        <Label fx:id="stressLabel" styleClass="data-label" text="Напруження у вузлах"/>
        <Label fx:id="stressSecondaryLabel" styleClass="secondary-label" text="(напруження по мізесу)"/>
        <Button fx:id="stressButton" styleClass="load-button" text="Завантажити файл" onMouseClicked="#selectStressFile"/>
    </VBox>

    <VBox styleClass="vbox-label-button">
        <Label fx:id="displacementLabel" styleClass="data-label" text="Переміщення у вузлах"/>
        <Button fx:id="displacementButton" styleClass="load-button" text="Завантажити файл" onMouseClicked="#selectDisplacementsFile"/>
    </VBox>

    <VBox styleClass="vbox-label-button">
        <Label fx:id="characteristicLabel" styleClass="data-label" text="Довільна характеристика"/>
        <Button fx:id="characteristicButton" styleClass="load-button" text="Завантажити файл" onMouseClicked="#selectCustomCharacteristicFile"/>
    </VBox>

</VBox>
